---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatDate, isoDate, langStaticPaths, localePath, useTranslations, type Lang } from '../../../i18n/utils';
import { getArticles } from '../../../lib/articles';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const articles = (await getArticles()).filter((article) => article.lang === lang);
---

<BaseLayout lang={lang} path="articles" title={t('articles.title')}>
  <h1>{t('articles.title')}</h1>
  {articles.length === 0 ? (
    <p class="muted">{t('articles.empty')}</p>
  ) : (
    <ul class="entries">
      {articles.map(({ entry, slug }) => (
        <li>
          <time class="muted small" datetime={isoDate(entry.data.date)}>{formatDate(entry.data.date, lang)}</time>
          <a class="entry-title" href={localePath(lang, `articles/${slug}`)}>{entry.data.title}</a>
          {entry.data.description && <p class="muted">{entry.data.description}</p>}
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
